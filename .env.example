# Copy this file to .env and set a password with at least 16 characters.
# Keep .env private; the admin password protects the anonymous analytics dashboard.
ADMIN_PASSWORD=replace-this-with-a-long-private-password

# Optional. Defaults to data/rivora.sqlite for local development.
DATABASE_PATH=data/rivora.sqlite

# Render or another host sets PORT automatically.
PORT=3000
